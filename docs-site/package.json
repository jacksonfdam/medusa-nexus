{
  "name": "medusanexus-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel-hosted documentation site for MedusaNexus. Nextra (Next.js + MDX). Markdown is source of truth.",
  "scripts": {
    "postinstall": "patch-package",
    "prebuild": "python3 scripts/gen_reference.py",
    "predev": "python3 scripts/gen_reference.py",
    "dev": "next dev --port 3030 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^16.2.7",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
